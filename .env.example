# DANDOONJAN EVIDENCE CORE V0 — environment template (copy to .env; never commit real secrets)
DJ_DATABASE_URL=sqlite:///./dandoonjan_dev.db
# PostgreSQL uses the psycopg 3 driver. Real deployment access is out of scope.
# Credential-free temporary local Unix-socket rehearsal example:
# DJ_DATABASE_URL=postgresql+psycopg:///dandoonjan_rc?host=/tmp/dandoonjan-rc-socket
DJ_ARTIFACT_STORAGE_DIR=./artifact_store
DJ_AI_PROVIDER=mock
DJ_AI_MODEL_NAME=mock-evidence-v1
# Only needed if DJ_AI_PROVIDER=openrouter:
DJ_OPENAI_API_KEY=
DJ_OPENROUTER_API_KEY=
DJ_MAX_UPLOAD_BYTES=26214400
# Production must set true: refuses knowledge packs that are not clinician-reviewed
DJ_REQUIRE_CLINICIAN_REVIEWED_KNOWLEDGE_PACK=false
DJ_ENVIRONMENT=development
# Same-origin UI needs no CORS grant; separate approved UI origins use a JSON array.
DJ_CORS_ORIGINS=[]
