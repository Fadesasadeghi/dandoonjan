# DANDOONJAN EVIDENCE CORE V0 — environment template (copy to .env; never commit real secrets)
DJ_DATABASE_URL=sqlite:///./dandoonjan_dev.db
# PostgreSQL uses the psycopg 3 driver. Real deployment access is out of scope.
# Credential-free temporary local Unix-socket rehearsal example:
# DJ_DATABASE_URL=postgresql+psycopg:///dandoonjan_rc?host=/tmp/dandoonjan-rc-socket
DJ_ARTIFACT_STORAGE_DIR=./artifact_store
DJ_LIVE_PROVIDER_ENABLED=false
DJ_AI_PROVIDER=mock
DJ_AI_MODEL_NAME=mock-evidence-v1
# Only needed if DJ_AI_PROVIDER=openrouter:
DJ_OPENAI_API_KEY=
DJ_OPENROUTER_API_KEY=
DJ_MAX_UPLOAD_BYTES=26214400
# Production must set true: refuses knowledge packs that are not clinician-reviewed
DJ_REQUIRE_CLINICIAN_REVIEWED_KNOWLEDGE_PACK=false
DJ_ENVIRONMENT=development
# Same-origin UI needs no CORS grant; separate approved UI origins use a JSON array.
DJ_CORS_ORIGINS=[]

# Gate 7.5B: explicit hosted MOCK staging profile (not a deployment command).
# Override the local defaults above in the actual service environment:
# DJ_ENVIRONMENT=staging
# DJ_DATABASE_URL=<approved synthetic PostgreSQL 16 postgresql+psycopg URL>
# DJ_ARTIFACT_STORAGE_DIR=/app/data/artifact_store
# DJ_AUTH_FOUNDATION_ENABLED=true
# DJ_AUTH_ALLOWED_ORIGINS=["https://dazzling-bombolone-90006d.netlify.app"]
# DJ_CORS_ORIGINS=[]
# DJ_AI_PROVIDER=mock
# DJ_AI_MODEL_NAME=mock-evidence-v1
# DJ_LIVE_PROVIDER_ENABLED=false
# DJ_LOCAL_SYNTHETIC_ACCEPTANCE_ENABLED=false
# DJ_REQUIRE_CLINICIAN_REVIEWED_KNOWLEDGE_PACK=true
# DJ_RENDER_STAGING_HTTPS_BOUNDARY=render-managed-tls
# Explicit staging-only assertion: Render terminates HTTPS, redirects HTTP, and
# shields the app listener from direct public access. Uvicorn proxy headers OFF.
# DJ_TRUSTED_PROXY_PEERS must be ABSENT in this mode, even an empty value fails.
# Default boundary is disabled. Normal/production mode still requires:
# DJ_TRUSTED_PROXY_PEERS=<verified finite comma-separated literal ingress IPs>
# PORT=<platform-supplied listener port, default 8000 outside Render>
# DJ_OPENROUTER_API_KEY and DJ_OPENAI_API_KEY intentionally absent in staging.
# Nonempty provider credentials fail staging preflight; no real keys are needed.
# Knowledge Pack is pending: reviewed clinical processing must remain blocked.
# Never use this boundary on a publicly reachable plaintext listener. It does
# not add Render's origin to auth origins or grant whole-environment privacy.
# Netlify uses DANDOONJAN_BACKEND_URL=<exact HTTPS Render origin, no trailing slash>.
# Never put database/provider secrets in Netlify.
# Ephemeral artifacts are NOT durable acceptance: no restart recovery/history claim.
